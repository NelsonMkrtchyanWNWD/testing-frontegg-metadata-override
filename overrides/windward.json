{
  "themeV2": {
    "loginBox": {
      "logo": {
        "image": "https://testing-frontegg-metadata-override.vercel.app/black-box.svg",
        "alignment": "center",
        "placement": "page",
        "style": {
          "display": "flex",
          "justifyContent": "center",
          "alignItems": "center",
          "margin": "0 auto",
          "& img": {
            "width": "260px",
            "height": "60px"
          },
          "@media (max-width: 600px)": {
            "marginBottom": "24px"
          }
        }
      },
      "rootStyle": {
        "& [data-test-id=\"forgot-password-btn\"]": {
          "display": "none"
        }
      }
    }
  },
  "localizations": {
    "en": {
      "errors": {
        "ER-01196": "Invalid credentials",
        "ER-01078": "Incorrect username or password"
      }
    }
  }
}
