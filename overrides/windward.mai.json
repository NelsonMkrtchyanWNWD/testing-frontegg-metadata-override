{
  "themeV2": {
    "loginBox": {
      "themeName": "classic",
      "logo": {
        "image": "https://marint-web-static.wnwd.com/maix/logo-dark.svg",
        "alignment": "center",
        "placement": "page",
        "style": {
          "display": "flex",
          "justifyContent": "center",
          "alignItems": "center"
        }
      },
      "rootStyle": {
        "backgroundColor": "#020817",
        "backgroundImage": "url(https://marint-web-static.wnwd.com/maix/login-background.svg)",
        "backgroundSize": "cover",
        "backgroundPosition": "center",
        "backgroundRepeat": "no-repeat",
        "& [data-test-id=\"forgot-password-btn\"]": {
          "color": "#f8fafc",
          "textDecoration": "underline"
        },
        "& h1, & h2": {
          "color": "#f8fafc"
        }
      },
      "boxStyle": {
        "backgroundColor": "#0a192f",
        "border": "1px solid #314158",
        "borderRadius": "16px",
        "boxShadow": "0px 4px 10px 0px rgba(0,0,0,0.15)"
      },
      "palette": {
        "primary": {
          "main": "#00a3cc",
          "dark": "#0089ab",
          "light": "#33b5d6",
          "hover": "#0089ab",
          "active": "#0089ab",
          "contrastText": "#020817"
        }
      },
      "inputTheme": {
        "base": {
          "color": "#f8fafc",
          "borderColor": "#314158",
          "backgroundColor": "rgba(30,41,59,0.3)"
        },
        "label": {
          "color": "#f8fafc"
        }
      },
      "submitButtonTheme": {
        "base": {
          "color": "#020817",
          "borderColor": "#00a3cc",
          "backgroundColor": "#00a3cc"
        }
      },
      "typographyStyleOptions": {
        "fontFamily": "Inter, sans-serif"
      }
    }
  },
  "localizations": {
    "en": {
      "loginBox": {
        "login": {
          "title": "Login",
          "subTitle": "Sign in to WW Agentic"
        }
      },
      "errors": {
        "ER-01196": "Invalid credentials",
        "ER-01078": "Incorrect username or password"
      }
    }
  }
}
