{
  "themeV2": {
    "loginBox": {
      "themeName": "classic",
      "logo": {
        "image": "https://cdn.us.frontegg.com/public-vendor-assets/25c44fa2-6aea-4f39-aa7b-0a699eb9da03/assets/logo-1772020657888.svg%2Bxml",
        "alignment": "center",
        "placement": "page",
        "style": {
          "display": "flex",
          "justifyContent": "center",
          "alignItems": "center",
          "position": "relative",
          "&::after": {
            "content": "'Beta'",
            "marginLeft": "8px",
            "padding": "2px 10px",
            "fontSize": "12px",
            "lineHeight": "16px",
            "fontFamily": "Inter, Roboto, sans-serif",
            "fontWeight": "500",
            "color": "#94a3b8",
            "border": "1px solid #314158",
            "borderRadius": "6px",
            "letterSpacing": "0.2px"
          }
        }
      },
      "rootStyle": {
        "backgroundColor": "#020817",
        "backgroundImage": "url(https://marint-web-static.wnwd.com/maix/login-background.svg)",
        "backgroundSize": "cover",
        "backgroundPosition": "center",
        "backgroundRepeat": "no-repeat",
        "& [data-test-id=\"forgot-password-btn\"]": {
          "color": "#f8fafc",
          "textDecoration": "underline"
        }
      },
      "boxStyle": {
        "backgroundColor": "#0a192f",
        "border": "1px solid #314158",
        "borderRadius": "16px",
        "boxShadow": "0px 4px 10px 0px rgba(0,0,0,0.15)"
      },
      "palette": {
        "primary": {
          "main": "#00a3cc",
          "dark": "#0089ab",
          "light": "#33b5d6",
          "hover": "#0089ab",
          "active": "#0089ab",
          "contrastText": "#020817"
        }
      },
      "inputTheme": {
        "base": {
          "color": "#f8fafc",
          "borderColor": "#314158",
          "backgroundColor": "rgba(30,41,59,0.3)"
        },
        "label": {
          "color": "#f8fafc"
        }
      },
      "submitButtonTheme": {
        "base": {
          "color": "#020817",
          "borderColor": "#00a3cc",
          "backgroundColor": "#00a3cc"
        }
      },
      "typographyStyleOptions": {
        "fontFamily": "Inter, sans-serif"
      }
    }
  },
  "localizations": {
    "en": {
      "errors": {
        "ER-01196": "Invalid credentials",
        "ER-01078": "Incorrect username or password"
      }
    }
  }
}
